# API mode:
#   hybrid (default) = routes that exist in backend/routes/api.php (login, signup, users, roles,
#                      companies, branches, invitations, products, purchases, sales, inwards/outwards)
#                      call the Laravel API below; modules the backend lacks use the in-browser mock.
#   true             = everything mocked (demo accounts like owner@demo.test only work here)
#   false            = everything goes to Laravel
NEXT_PUBLIC_USE_MOCK=hybrid
NEXT_PUBLIC_API_URL=http://smart-business-backend-stagging.test
