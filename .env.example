# API mode:
#   false (default) = every call goes to the Laravel 12 backend below. The backend implements all
#                     MVP modules (auth, org, inventory, purchasing, sales, returns, parties, finance,
#                     accounting, reports, billing, platform admin).
#   hybrid          = every endpoint listed in src/lib/api/routing.ts (all backend routes) goes to
#                     Laravel; only an unknown path falls back to the in-browser mock.
#   true            = everything mocked offline. The demo accounts (owner@demo.test / Demo@1234)
#                     only work in this mode.
#
# Logins for the backend seed (php artisan migrate:fresh --seed), password Password123!:
#   owner@metrotraders.test (start here), manager@metrotraders.test, sales@metrotraders.test,
#   warehouse@metrotraders.test, owner@northwind.test, admin@smartbusiness.test (platform admin)
NEXT_PUBLIC_USE_MOCK=false
# Laravel base URL without /api (the client adds /api).
NEXT_PUBLIC_API_URL=http://smart-business-backend-stagging.test
# Live calls time out after 5 seconds so a hanging backend cannot freeze the UI.
# For an offline demo with no Laravel, use: NEXT_PUBLIC_USE_MOCK=true
